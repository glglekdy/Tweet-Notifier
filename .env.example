# ═══════════════════════════════════════════════════════════════════
#  Tweet-Notifier 설정 안내
# ═══════════════════════════════════════════════════════════════════
#
#  1) 이 파일을 복사해 같은 폴더에 .env 라는 이름으로 저장하세요.
#     (이 파일 자체에는 실제 값을 넣지 마세요. 이 파일은 git 에 올라갑니다.)
#  2) .env 의 빈칸을 아래 안내대로 채웁니다.
#  3) python app.py 로 실행합니다.
#
#  Dishost 에 올릴 때는 .env 파일 대신 패널의 환경변수 탭에 같은 이름으로 넣어도 됩니다.
#  값이 빠졌거나 형식이 틀리면 봇이 켜질 때 "설정 오류: ..." 로 무엇이 문제인지 알려줍니다.


# ── 필수 ①  디스코드 봇 토큰 ─────────────────────────────────────────
#
#  1. https://discord.com/developers/applications 접속 → New Application
#  2. 왼쪽 Bot 메뉴 → Reset Token → 나온 값을 복사해 아래에 붙여넣기
#     (토큰은 한 번만 보여줍니다. 남에게 보이면 바로 Reset 하세요.)
#  3. 봇 이름을 바꾸려면 같은 Bot 메뉴의 USERNAME 을 고치세요.
#  4. 서버 초대: 왼쪽 OAuth2 → URL Generator 에서
#       SCOPES      : bot, applications.commands
#       PERMISSIONS : View Channels, Send Messages, Send Messages in Threads,
#                     Embed Links, Mention Everyone(모든 역할 멘션)
#     를 고르고, 아래에 생긴 링크로 서버에 초대합니다.
#  Privileged Gateway Intents 는 하나도 켤 필요가 없습니다.
DISCORD_TOKEN=


# ── 필수 ②  봇이 트위터를 읽을 때 쓰는 계정 ────────────────────────────
#
#  형식:  별명:auth_token        여러 개면 쉼표로:  sub1:값,sub2:값
#   - 별명은 /twitter add 의 '봇계정' 에서 고를 때 쓰는 이름입니다. 영문·숫자·_·- 만 쓰세요.
#   - 별명 없이 값만 넣으면 실행되지 않습니다.  (X)  abcd1234...   (O)  sub1:abcd1234...
#
#  auth_token 얻는 법:
#   1. 브라우저에서 봇용 트위터 계정으로 x.com 에 로그인
#   2. F12(개발자 도구) → Application(저장소) → Cookies → https://x.com
#   3. auth_token 의 Value(40자 정도) 를 복사
#   4. 그 브라우저에서 로그아웃하지 말고 창만 닫기 (로그아웃하면 값이 무효가 됩니다)
#
#  ⚠️ 이 계정은 추적 대상을 실제로 팔로우하고 알림(종)을 켭니다.
#     트위터 정책상 제재될 수 있으니 본 계정 대신 부계정을 쓰세요.
#  ⚠️ 이미 쓰던 별명의 값을 "다른 트위터 계정" 것으로 바꾸면 알림이 오지 않습니다.
#     새 별명으로 추가한 뒤 /twitter add ... 봇계정:새별명 으로 옮기세요.
#     (같은 계정의 값이 만료돼 새로 받은 경우는 값만 바꾸고 재시작하면 됩니다.)
TWITTER_TOKEN=


# ── 선택 ─────────────────────────────────────────────────────────────
#
#  ID 복사하는 법: 디스코드 설정 → 고급 → 개발자 모드 켜기
#                  → 서버 아이콘(또는 채널) 우클릭 → "ID 복사"

# 테스트 서버 ID. 넣으면 /twitter 명령어가 그 서버에 바로 뜹니다.
# 비워두면 모든 서버에 등록되며, 디스코드에 반영되기까지 최대 1시간 걸립니다.
GUILD_ID=

# 관리자 경고를 받을 채널 ID. 봇 트위터 계정 로그인 실패, 조회 제한이 10분 넘게 이어질 때 알려줍니다.
# 비우면 로그에만 남깁니다.
ALERT_CHANNEL_ID=

# 트위터 알림 탭 조회 간격(초). 기본 18, 10 미만이면 10 으로 올립니다.
# 너무 짧으면 트위터가 조회를 제한할 수 있습니다.
TWITTER_CHECK_SECONDS=18

# 추적 목록(DB)과 트위터 로그인 세션이 저장되는 폴더. 지우면 추적 목록이 사라집니다.
DATA_DIR=data
